# ── Database (Neon Postgres in prod, docker-compose locally) ─────────────────
DATABASE_URL=postgres://vaanidesk:vaanidesk@localhost:5432/vaanidesk

# ── Redis (Upstash in prod, docker-compose locally) ──────────────────────────
REDIS_URL=redis://localhost:6379

# ── API service ──────────────────────────────────────────────────────────────
API_PORT=4000
# Public origin Twilio reaches (ngrok tunnel in dev) — webhook signatures are computed over it
PUBLIC_API_URL=http://localhost:4000
# Dashboard origin allowed for credentialed CORS
WEB_ORIGIN=http://localhost:3000
# Secret authenticating the voice gateway on /v1/internal/* (min 16 chars)
INTERNAL_SERVICE_SECRET=change-me-32-chars-minimum-secret
# enforce (prod) | log (local dev without real Twilio signatures)
WEBHOOK_SIGNATURE_MODE=enforce

# ── Web (Next.js) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Where server components reach the api; browser WS uses the public variant
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_API_WS_URL=ws://localhost:4000
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Passwordless email sign-in (Resend magic links)
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=VaaniDesk <login@vaanidesk.dev>

# ── Voice gateway ────────────────────────────────────────────────────────────
GATEWAY_PORT=4100
# Where the api's TwiML points call media (public wss:// in prod, ngrok in dev)
GATEWAY_STREAM_URL=wss://localhost:4100/stream
API_BASE_URL=http://localhost:4000
DEEPGRAM_MODEL=nova-3
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# ── Telephony (Twilio primary; Exotel adapter available) ─────────────────────
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=
# Shared token appended to Exotel webhook URLs (?token=...) — Exotel has no HMAC
EXOTEL_WEBHOOK_TOKEN=

# ── Speech-to-text ───────────────────────────────────────────────────────────
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
SARVAM_API_KEY=

# ── LLM (agent brain) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-4-5-20251001
# Model used by the eval harness judge (defaults to AGENT_MODEL)
EVAL_JUDGE_MODEL=

# ── Text-to-speech ───────────────────────────────────────────────────────────
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=

# ── WhatsApp Cloud API ───────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me-webhook-verify
WHATSAPP_GRAPH_VERSION=v21.0
# Pre-approved template names in the WhatsApp manager (see ADR-0006 for the param contract)
WHATSAPP_TEMPLATE_CONFIRMATION=vd_booking_confirmation
WHATSAPP_TEMPLATE_REMINDER=vd_booking_reminder
WHATSAPP_TEMPLATE_CANCELLATION=vd_booking_cancellation
WHATSAPP_TEMPLATE_LANGUAGE=en
WORKER_CONCURRENCY=5

# ── Object storage (call recordings — private bucket, signed URLs) ───────────
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=vaanidesk-recordings
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Observability (all optional; unset = disabled, clean no-op) ───────────────
# Prometheus scrapes each service's /metrics (guarded by INTERNAL_SERVICE_SECRET).
# OpenTelemetry tracing: set to an OTLP/HTTP collector base URL to enable traces.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Sentry error tracking (server side). Leave blank to disable.
SENTRY_DSN=
# Browser-side Sentry for the dashboard (must be NEXT_PUBLIC_ to reach the client).
NEXT_PUBLIC_SENTRY_DSN=
# Release identifier tagged on events (e.g. git sha). NEXT_PUBLIC_ variant for the browser.
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=
